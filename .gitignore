# Environment
.env
*.env

# Database (ignore the DB file itself — keep schema via models.py)
data/*.db
data/*.db-shm
data/*.db-wal

# Uploads (personal files)
uploads/

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
env/
*.egg-info/
dist/
build/

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp

# Compiled EXE (too large for GitHub)
*.exe

# Obsidian vault — personal workspace/UI state per user (not shared)
vault/.obsidian/

# Keep these dirs tracked
!data/.gitkeep
!uploads/.gitkeep

# Salidas de los agentes (ficheros generados)
Agentes-CyberKB/Editor/*/videos/
Agentes-CyberKB/Editor/*/resumenes/
Agentes-CyberKB/Editor/*/agrupaciones/
# Marcador de sembrado único del catálogo base de herramientas (runtime)
.tools_base_seeded

# Registro de decisiones del mockup del Editor (log de trabajo, solo local)
Agentes-CyberKB/Editor/DECISIONES_EDITOR.md

# Comparativa main/capas vs agentes (referencia de trabajo, solo local)
Agentes-CyberKB/Editor/COMPARATIVA_MAIN_VS_AGENTES.md
