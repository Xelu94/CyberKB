# ─── API Keys ────────────────────────────────────────────────────────────────
# OBLIGATORIA — Claude AI (análisis, extracción, informes, forense)
ANTHROPIC_API_KEY=sk-ant-api03-...

# Opcional — transcripción de vídeo por Whisper (alternativa a subtítulos oficiales)
OPENAI_API_KEY=

# ─── OSINT & Threat Intel (opcionales — dejar vacío para deshabilitar) ────────
VIRUSTOTAL_API_KEY=          # Gratis — virustotal.com/gui/my-apikey
ABUSEIPDB_API_KEY=           # Gratis (1000/día) — abuseipdb.com/api
MALWAREBAZAAR_API_KEY=       # Gratis — bazaar.abuse.ch/api
HUNTER_API_KEY=              # Gratis (25/mes) — hunter.io/api-keys
SHODAN_API_KEY=              # De pago — account.shodan.io
URLSCAN_API_KEY=             # Gratis — urlscan.io/user/profile
HIBP_API_KEY=                # ~3.50$/mes — haveibeenpwned.com/API/Key
LEAKRADAR_API_KEY=           # DeHashed compatible — dehashed.com
ANYRUN_API_KEY=              # Gratis (tier limitado) — any.run/plans

# ─── App config ──────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./data/cyberkb.db
UPLOAD_DIR=./uploads
PORT=8000

# ─── Vault de Obsidian (opcional) ─────────────────────────────────────────────
# Carpeta donde vive TU vault local. Cada persona pone la suya (Obsidian > Abrir
# carpeta como almacén > la ruta de abajo). Si se deja vacío, se usa ./vault
# dentro del proyecto. Regenerar con: python scripts/migrate_to_obsidian.py
OBSIDIAN_VAULT_DIR=
